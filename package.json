{
  "name": "web-notes",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "predev": "node scripts/copy-editor.mjs && node scripts/build-local-service.mjs",
    "prebuild": "node scripts/copy-editor.mjs && node scripts/build-local-service.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg pkg --arm64",
    "pretest": "node scripts/copy-editor.mjs",
    "typecheck": "tsc -b",
    "prepreview": "node scripts/build-local-service.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "6.43.14",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "highlight.js": "^11.11.1",
    "idb": "8.0.4",
    "jszip": "3.10.2",
    "katex": "^0.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "vditor": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "description": "Local-first Markdown study notes with GitHub publishing and quiz mode",
  "author": "Zhiye",
  "build": {
    "appId": "app.zhiye.notes",
    "productName": "Zhiye Notes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Zhiye-Notes-${version}-${arch}.${ext}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "identity": null
    }
  }
}
